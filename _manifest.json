{
  "manifest_version": 2,
  "id": "omsociety.minecraft-adapter",
  "version": "1.0.0",
  "name": "Minecraft 聊天适配器",
  "description": "连接 Minecraft 服务器与 MaiBot，实现游戏内 AI 聊天、跨平台消息互通和服务器远程管理（状态查询/玩家列表/远程指令）",
  "author": {
    "name": "OMSociety",
    "url": "https://github.com/OMSociety"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/OMSociety/maibot_plugin_minecraft_adapter"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.1.0"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.png",
      "fallback": "package"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
